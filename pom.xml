<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <name>Trading</name>

    <groupId>io.github.ilijapol</groupId>
    <artifactId>trading</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>interaction</module>
        <module>analyzer</module>
        <module>app</module>
        <module>common</module>
        <module>market-data</module>
        <module>core</module>
        <module>exchange-connector</module>
        <module>pattern-repository</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bybit-java-api.version>1.4.0</bybit-java-api.version>
        <lombok.version>1.18.42</lombok.version>
        <jackson-databind.version>2.15.2</jackson-databind.version>
        <slf4j-api.version>2.0.17</slf4j-api.version>
        <log4j-core.version>2.25.3</log4j-core.version>
        <log4j-slf4j2-impl.version>2.25.3</log4j-slf4j2-impl.version>
        <junit-jupiter.version>5.9.2</junit-jupiter.version>
        <mockito-core.version>5.3.1</mockito-core.version>
        <mockito-junit-jupiter.version>5.3.1</mockito-junit-jupiter.version>
        <spring-boot.version>3.5.5</spring-boot.version>
        <revision>1.0-SNAPSHOT</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.johnnywic</groupId>
                <artifactId>bybit-java-api</artifactId>
                <version>${bybit-java-api.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson-databind.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>common</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j-api.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j-core.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-slf4j2-impl</artifactId>
                <version>${log4j-slf4j2-impl.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito-core.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito-junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>market-data-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>exchange-connector-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- Spring Boot starters with logging excluded -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter</artifactId>
                <version>${spring-boot.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring-boot.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-aop</artifactId>
                <version>${spring-boot.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-log4j2</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.7</version>
                <scope>runtime</scope>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>analyzer</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>pattern-repository</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>exchange-connector-bybit</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>io.github.ilijapol</groupId>
                <artifactId>market-data-bybit</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <!-- Формат имени тега: v1.0.0, v1.1.0 и т.д. -->
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- Автоматически менять версию и в дочерних модулях, если проект многомодульный -->
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <arguments>-DskipTests</arguments>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.16.2</version>
                <configuration>
                    <!-- Генерировать резервные копии pom.xml перед изменением -->
                    <generateBackupPoms>true</generateBackupPoms>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <scm>
        <connection>scm:git:https://github.com/IljiaPolstianoy/Trading.git</connection>
        <developerConnection>scm:git:https://github.com/IljiaPolstianoy/Trading.git</developerConnection>
        <url>https://github.com/IljiaPolstianoy/Trading.git</url>
        <tag>HEAD</tag>
    </scm>

</project>